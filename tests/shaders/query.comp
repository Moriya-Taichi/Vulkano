#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=1) in;
layout(set=0,binding=0) uniform accelerationStructureEXT scene;
layout(set=0,binding=1) buffer Result{uint hit;} result;
void main(){rayQueryEXT q;rayQueryInitializeEXT(q,scene,gl_RayFlagsOpaqueEXT,255,vec3(0,0,-1),0.001,vec3(0,0,1),100);while(rayQueryProceedEXT(q)){}result.hit=rayQueryGetIntersectionTypeEXT(q,true)==gl_RayQueryCommittedIntersectionTriangleEXT?1:0;}
