#version 450
layout(local_size_x=1) in;
layout(constant_id=0) const uint multiplier = 1;
layout(set=0,binding=0,std430) buffer Output { uint values[]; } outputData;
layout(push_constant) uniform Control { uint index; uint value; } control;
void main() { outputData.values[control.index] = control.value * multiplier; }
