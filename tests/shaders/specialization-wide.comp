#version 450
#extension GL_ARB_gpu_shader_int64 : require
layout(local_size_x = 1) in;
layout(constant_id = 0) const bool flag = false;
layout(constant_id = 1) const int64_t signedValue = int64_t(0);
layout(constant_id = 2) const uint64_t unsignedValue = uint64_t(0);
layout(constant_id = 3) const double preciseValue = 0.0LF;
layout(binding = 0) buffer Result { uint values[]; } result;
void main() {
    uint64_t a = uint64_t(signedValue + int64_t(7));
    uint64_t b = unsignedValue + uint64_t(3);
    uvec2 c = unpackDouble2x32(preciseValue + 0.5LF);
    result.values[0] = flag ? 1 : 0;
    result.values[1] = uint(a);
    result.values[2] = uint(a >> 32);
    result.values[3] = uint(b);
    result.values[4] = uint(b >> 32);
    result.values[5] = c.x;
    result.values[6] = c.y;
}
