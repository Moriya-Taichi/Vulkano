#version 460
#extension GL_EXT_ray_tracing : require
layout(set=0,binding=0) uniform accelerationStructureEXT scene;
layout(set=0,binding=1) buffer Result { uint hit; } result;
layout(location=0) rayPayloadEXT uint hit;
void main(){hit=0;traceRayEXT(scene,gl_RayFlagsOpaqueEXT,255,0,0,0,vec3(0,0,-1),0.001,vec3(0,0,1),100,0);result.hit=hit;}
