#version 450
layout(local_size_x=1, local_size_y=1) in;
layout(set=0, binding=0) uniform sampler2D sourceDepth;
layout(set=0, binding=1, std430) buffer Result { float values[]; } result;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    result.values[p.y * 2 + p.x] = texelFetch(sourceDepth, p, 0).r;
}
